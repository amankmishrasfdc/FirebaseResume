#!/bin/sh
set -e

remote_name="$1"
remote_url="$2"

if [ -z "$remote_url" ]; then
  remote_url=$(git remote get-url "$remote_name" 2>/dev/null || true)
fi

if [ -z "$remote_url" ]; then
  exit 0
fi

case "$remote_url" in
  git@github.com:*)
    repo_url="https://github.com/${remote_url#git@github.com:}"
    ;;
  ssh://git@github.com/*)
    repo_url="https://github.com/${remote_url#ssh://git@github.com/}"
    ;;
  *)
    repo_url="$remote_url"
    ;;
esac

repo_url="${repo_url%.git}"

echo "Opening repository after push: $repo_url"

if command -v open >/dev/null 2>&1; then
  open "$repo_url" >/dev/null 2>&1 || true
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$repo_url" >/dev/null 2>&1 || true
fi
